# Install:  sudo cp deploy/murphys-bench-disk-check.service /etc/systemd/system/
[Unit]
Description=Murphy's Bench disk-usage check (alerts if root fs is high)
After=network.target

[Service]
Type=oneshot
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP__
ExecStart=__APP__/scripts/mb_disk_check.sh 85
